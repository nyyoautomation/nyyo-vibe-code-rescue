{{- /* One line per finding (sort key, TAB, content) for the HTML table (@@HTML@@) and one for the CSV (@@CSV@@). Secrets are already masked by gitleaks --redact. */ -}}
{{- range . }}
@@HTML@@{{ .File | trimPrefix "/scan/" | trimPrefix "./" }}:{{ printf "%08d" .StartLine }}:{{ .RuleID }}:{{ .Commit }}	<tr><td><span class="tag {{ if .Commit }}t-hist{{ else }}t-files{{ end }}">{{ if .Commit }}Git history{{ else }}Current files{{ end }}</span></td><td><strong>{{ .RuleID | html }}</strong><br><small>{{ .Description | html }}</small></td><td class="mono f">{{ .File | trimPrefix "/scan/" | trimPrefix "./" | html }}</td><td class="num">{{ .StartLine }}</td><td class="mono nw">{{ if .Commit }}{{ trunc 8 .Commit }}<br><small>{{ trunc 10 .Date }}</small>{{ else }}-{{ end }}</td><td class="mono secret s">{{ .Secret | replace "\r" "" | replace "\n" " " | html }}</td></tr>
@@CSV@@{{ .File | trimPrefix "/scan/" | trimPrefix "./" }}:{{ printf "%08d" .StartLine }}:{{ .RuleID }}:{{ .Commit }}	"{{ if .Commit }}git history{{ else }}current files{{ end }}","{{ .RuleID }}","{{ .Description | replace "\"" "\"\"" }}","{{ .File | trimPrefix "/scan/" | trimPrefix "./" | replace "\"" "\"\"" }}",{{ .StartLine }},"{{ .Commit }}","{{ .Date }}","{{ .Secret | replace "\r" "" | replace "\n" " " | replace "\"" "\"\"" }}","{{ .Fingerprint | trimPrefix "/scan/" | trimPrefix "./" | replace "\"" "\"\"" }}"
{{- end }}
